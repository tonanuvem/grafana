# =============================================================================
# Variáveis do LAB GRAFANA — aplicadas ao bank-demo sem nenhum override de compose
# =============================================================================
# O run-stack.sh FUNDE este arquivo com o .env que já existir em
# ~/bank-demo-docker (o do Encontro 1 traz realm e token do Splunk) e gera o
# .env-efetivo, que é o passado ao docker compose. Você não perde o que já
# tinha, e este arquivo continua legível e versionado.
#
# Cada linha existe porque o compose do bank-demo declara a variável com
# ${VAR:-default} — o default é sempre o comportamento de sempre.
# =============================================================================

# ---- para onde vai a telemetria -----------------------------------------
# O collector do LAB GRAFANA está na MESMA rede do bank-demo, então é DNS interno.
# Nenhuma porta no host, nenhum conflito com o splunk-otel-collector.
OTEL_ENDPOINT_GRPC=http://otelcol:4317
OTEL_ENDPOINT_HTTP=http://otelcol:4318

# Logs das aplicações Python por OTLP, já com trace_id e span_id dentro do
# registro — é o que faz o clique Loki → Tempo funcionar.
OTEL_LOGS_EXPORTER=otlp

# Sem isto a recusa de transferência não aparece em lugar nenhum: o
# logging.basicConfig(DEBUG) da aplicação vira no-op porque a distro OTel
# configura o logger antes.
OTEL_PYTHON_LOG_LEVEL=debug

# Logs do Node/nginx/UI pelo log driver do Docker. 8007 porque a 8006 é do
# collector da Splunk — quem abre a conexão é o daemon, no host.
FLUENTD_PORT=8007

# ---- comportamento da aplicação em aula ---------------------------------
# O cliente vê "serviço indisponível" em vez de SyntaxError.
# Mude para false e recarregue para reproduzir o achado do Encontro 1.
ERROS_AMIGAVEIS=true

# ---- RUM (Grafana Faro) ---------------------------------------------------
# Quem posta aqui é o NAVEGADOR do aluno, não o container.
# "auto" resolve pelo hostname que o navegador usou — serve localhost, IP
# público e qualquer DNS, sem ninguém precisar adivinhar o endereço externo.
# Deixe vazio para desligar o RUM.
FARO_COLLECTOR_URL=auto
FARO_APP_NAME=fiap-bank-ui

# A versão publicada, a regressão simulada e a porta do dashboard NÃO ficam
# aqui: mudam a cada execução e sujariam um arquivo versionado toda vez
# que alguém desse aula. Vivem em estado/ambiente.env, que os scripts
# criam e o git ignora.
